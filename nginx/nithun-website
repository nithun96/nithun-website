# Keep Shelf cover art (other people's book covers, hosted by Open Library) out of
# Google Images, where it showed up in searches for Nithun's name. Sent as an HTTP
# header so it doesn't rely on Google running the page's JavaScript.
# Photos in posts (/images/writing/) and the travel photos on About (/images/about/photo-*)
# get "noindex" on the image file itself, so they stay out of image search wherever they
# appear. Only the photos of Nithun himself stay indexable.
# $request_uri, not $uri: try_files rewrites $uri to /index.html.
map $request_uri $robots_tag {
    ~^/shelf/?(\?.*)?$  "noimageindex";
    ~^/images/writing/  "noindex";
    ~^/images/about/photo-  "noindex";
    default             "";
}

# Redirect nithunmanoharan.com to nithun.no
server {
    listen 80;
    listen 443 ssl;
    server_name nithunmanoharan.com www.nithunmanoharan.com;

    ssl_certificate /etc/letsencrypt/live/nithunmanoharan.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nithunmanoharan.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Let's Encrypt renewal checks are answered here rather than redirected to
    # nithun.no, so the redirect lives in `location /`, not a server-level `return`.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://nithun.no$request_uri;
    }
}

# Primary domain: nithun.no
server {
    listen 80;
    server_name nithun.no www.nithun.no;
    return 301 https://$host$request_uri;
}

# www.nithun.no → nithun.no, so Google sees one copy of each page
server {
    # http2 is enabled for all of port 443 by the nithun.no block below;
    # repeating it here makes nginx 1.24 warn.
    listen 443 ssl;
    server_name www.nithun.no;

    ssl_certificate /etc/letsencrypt/live/nithun.no/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nithun.no/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        return 301 https://nithun.no$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name nithun.no;
    root /var/www/nithun-website/dist;
    index index.html;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://covers.openlibrary.org https://archive.org https://*.archive.org; connect-src 'self'; frame-src https://open.spotify.com; frame-ancestors 'none'" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Robots-Tag $robots_tag always;   # empty (not sent) except on /shelf, /images/writing/ and /images/about/photo-*

    # Compression. `gzip on` is set in nginx.conf, but only for HTML by default.
    gzip_types text/css application/javascript application/json image/svg+xml text/xml application/xml text/plain;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 256;

    # Caching. `expires` sets Cache-Control without using add_header, so the
    # security headers above still apply in these locations.
    # Vite gives built files a content hash in the name, so they never change.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }
    location /fonts/ {
        expires 30d;
        try_files $uri =404;
    }
    location /images/ {
        expires 7d;
        try_files $uri =404;
    }

    # Pages, sitemap, robots.txt: always revalidate, so a deploy shows up at once.
    location / {
        expires -1;
        # $uri.html = the per-page copies scripts/prerender.js writes (title, description,
        # Open Graph tags), so link previews show the right page without JavaScript.
        # No $uri/: dist/writing/ is now a folder, and /writing/ would hit it and 403.
        try_files $uri $uri.html /index.html;
    }

    ssl_certificate /etc/letsencrypt/live/nithun.no/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nithun.no/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}
