    },
    "2 is closer": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "2 ligner mest"
          }
        }
      }
    },
    "Fine-tune with the slider": {
      "localizations": {
        "nb": {
          "stringUnit": {
