# Redirect nithunmanoharan.com to nithun.no
server {
    listen 80;
    listen 443 ssl;
    server_name nithunmanoharan.com www.nithunmanoharan.com;

    ssl_certificate /etc/letsencrypt/live/nithunmanoharan.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nithunmanoharan.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Let's Encrypt renewal checks must be answered here, not redirected to
    # nithun.no. A server-level `return` runs before any location, which made
    # renewal fail (cert expired July 2026) — so the redirect lives in `location /`.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://nithun.no$request_uri;
    }
}

# Primary domain: nithun.no
server {
    listen 80;
    server_name nithun.no www.nithun.no;
    return 301 https://$host$request_uri;
}

# www.nithun.no → nithun.no, so Google sees one copy of each page
server {
    # http2 is enabled for all of port 443 by the nithun.no block below;
    # repeating it here makes nginx 1.24 warn.
    listen 443 ssl;
    server_name www.nithun.no;

    ssl_certificate /etc/letsencrypt/live/nithun.no/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nithun.no/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        return 301 https://nithun.no$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name nithun.no;
    root /var/www/nithun-website/dist;
    index index.html;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://covers.openlibrary.org https://archive.org https://*.archive.org; connect-src 'self'; frame-src https://open.spotify.com; frame-ancestors 'none'" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    ssl_certificate /etc/letsencrypt/live/nithun.no/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nithun.no/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}
