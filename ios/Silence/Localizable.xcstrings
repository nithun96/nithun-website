    },
    "8 hours": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "8 timer"
          }
        }
      }
    },
    "eight hours": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "åtte timer"
          }
        }
      }
    },
    "all night": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "hele natten"
          }
        }
      }
    },
    "Silence couldn't start the sound. Open the app and try again.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Silence fikk ikke startet lyden. Åpne appen og prøv igjen."
          }
        }
      }
    },
    "Play a sound": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spill av en lyd"
          }
        }
      }
    },
    "Plays one of Silence's sounds with your volume and tone from the app.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiller en av lydene i Silence med volumet og klangen du har valgt i appen."
          }
        }
      }
    },
    "Minutes": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutter"
          }
        }
      }
    },
    "Stops the sound after this many minutes (1 to 720). Leave it empty to use the sleep timer set in the app.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopper lyden etter så mange minutter (1 til 720). La feltet stå tomt for å bruke sovetimeren du har valgt i appen."
          }
        }
      }
    },
    "Play ${sound}": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spill av ${sound}"
          }
        }
      }
    },
    "Play with a sleep timer": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spill av med sovetimer"
          }
        }
      }
    },
    "Plays your last sound and stops it after the time you choose.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiller den siste lyden din og stopper den etter tiden du velger."
          }
        }
      }
    },
    "Play for ${length}": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spill av i ${length}"
          }
        }
      }
    },
    "Stop the sound": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopp lyden"
          }
        }
      }
    },
    "Stops whatever Silence is playing.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopper det Silence spiller."
          }
        }
      }
    },
    "Play or stop": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spill av eller stopp"
          }
        }
      }
    },
    "Plays your last sound, or stops it if one is playing.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiller den siste lyden din, eller stopper den hvis noe spilles."
          }
        }
      }
    },
    "Sound to compare": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyd å sammenligne med"
          }
        }
      }
    },
    "Tone is a single clear note. Hiss is a soft rush of sound around the pitch; many people find it closer to their tinnitus.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tone er én klar tone. Sus er en myk susing rundt tonehøyden; mange synes den ligner mer på tinnitusen sin."
          }
        }
      }
    },
    "Play the hiss": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spill av suset"
          }
        }
      }
    },
    "Stop the hiss": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopp suset"
          }
        }
      }
    },
    "%lld dB": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dB"
          }
        }
      }
    },
    "One more check: which is most like it?": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Én ting til: hvilken ligner mest?"
          }
        }
      }
    },
    "It's easy to land on the right note in the wrong octave. Play each one and choose the closest.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er lett å treffe riktig tone, men i feil oktav. Spill av hver av dem og velg den som ligner mest."
          }
        }
      }
    },
    "This one": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne"
          }
        }
      }
    },
    "Stop": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopp"
          }
        }
      }
    },
    "Play %@, %@": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spill av %1$@, %2$@"
          }
        }
      }
    },
    "Stop %@, %@": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopp %1$@, %2$@"
          }
        }
      }
    },
    "Choose": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg"
          }
        }
      }
    },
    "Choose %@, %@": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg %1$@, %2$@"
          }
        }
      }
    },
    "Skip": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hopp over"
          }
        }
      }
    },
    "matchSound.tone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tone"
          }
        },
        "nb": {
